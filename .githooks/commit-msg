#!/usr/bin/env bash
set -euo pipefail

msg_file=${1:?commit message file is required}
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge\ *) exit 0 ;;
esac
generated_revert='^Revert ".+"$'
if [[ "$first_line" =~ $generated_revert ]]; then exit 0; fi

# Conventional commits: type(scope)!: description
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._-]*\))?(!)?: .{1,72}$'
if [[ ! "$first_line" =~ $pattern ]]; then
  printf '%s\n' 'FAIL: expected type(scope)!: description (1-72 characters).' \
    'Types: feat fix docs style refactor perf test build ci chore revert.' >&2
  exit 1
fi

# Internal tracker identifiers must never leak into public surfaces.
if grep -nEq '(EPIC|STORY|TASK|BUG)-[0-9]+' "$msg_file"; then
  printf '%s\n' 'FAIL: commit message contains internal tracker identifiers.' \
    'Describe the change by its content, not by its ticket.' >&2
  exit 1
fi
